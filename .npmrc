# Pacotes nunca executam scripts de instalação (preinstall/install/postinstall).
# Nenhuma dependência do projeto precisa deles; isto bloqueia o vetor mais comum de ataque via npm.
ignore-scripts=true
# Recusa instalar com versões de Node/npm diferentes das declaradas em "engines".
engine-strict=true
# Só o registro oficial.
registry=https://registry.npmjs.org/
# Grava versões exatas ao adicionar novas dependências.
save-exact=true
